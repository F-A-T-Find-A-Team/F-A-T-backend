# Copy to an ignored .env file. Fill local values; never commit real credentials.
# Keep this file shell-compatible: quote values containing shell-special characters.
DB_URL='jdbc:mysql://127.0.0.1:3307/fat_dev?serverTimezone=Asia/Seoul&characterEncoding=UTF-8'
DB_USERNAME=fat_dev
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
SPRING_PROFILES_ACTIVE=dev

# Two independent secrets, each at least 32 UTF-8 bytes. No production fallback.
JWT_SECRET=
EMAIL_CODE_SECRET=

# Only false for local HTTP. Keep true with HTTPS in deployed environments.
AUTH_SECURE_COOKIE=false

# Real SMTP is required to deliver verification codes; no code is returned/logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Local example. Use a persistent, backed-up directory/volume in production.
AVATAR_STORAGE_PATH=/tmp/fat-avatars
